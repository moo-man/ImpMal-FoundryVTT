<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    <div class="attribute-row flexrow">
        <div class="attribute-box top-label">
            <div class="label" style="grid-column: 1 / span 12"><label
                    class="centered">{{localize "IMPMAL.Augmetics"}}</label>
            </div>
            <div class="field" style="grid-column: 1 / span 6"><input type="number" name="system.augmetics.value"
                    value="{{system.augmetics.value}}" disabled></div>
            <div class="field" style="grid-column: 7 / span 6"><input type="number" name="system.augmetics.max"
                    value="{{system.augmetics.max}}" disabled></div>
        </div>

        <div class="attribute-box top-label experience">
            <div class="label" style="grid-column: 1 / span 3"><label class="centered">{{localize "IMPMAL.XP"}}</label>
            </div>
            <div class="label" style="grid-column: 4 / span 3"><label
                    class="centered">{{localize "IMPMAL.Available"}}</label>
            </div>
            <div class="label" style="grid-column: 7 / span 3"><label
                    class="centered">{{localize "IMPMAL.Spent"}}</label></div>
            <div class="label" style="grid-column: 10 / span 3"><label
                    class="centered">{{localize "IMPMAL.Total"}}</label>
            </div>
            <div class="label" style="grid-column: 1 / span 3"></div>
            <div class="field" style="grid-column: 4 / span 3"><input type="number" value="{{system.xp.available}}"
                    disabled>
            </div>
            <div class="field" style="grid-column: 7 / span 3"><input type="number" value="{{system.xp.spent}}"
                    disabled></div>
            <div class="field" style="grid-column: 10 / span 3"><input type="number" value="{{system.xp.total}}"
                    name="system.xp.total" {{#unless (or (isGM) (settings "playerExperienceEditing" ))}} disabled
                    {{/unless}}>
            </div>
        </div>
    </div>

    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMPMAL.Handler"}}</div>
        </div>

        {{#if this.system.handler.list}}
            {{#each this.system.handler.list as |handler|}}
                <div class="list-content handler">
                    <a data-action="removeHandler" data-uuid="{{handler.uuid}}"><i class="fa-solid fa-xmark"></i></a>
                    <img src="{{tokenImg handler.document}}">
                    <label class="name">{{handler.name}}</label>
                </div>
            {{/each}}
        {{else}}
            <div>
                <label class="missing">{{localize "IMPMAL.NoHandler"}}</label>
            </div>
        {{/if}}
    </div>

</section>